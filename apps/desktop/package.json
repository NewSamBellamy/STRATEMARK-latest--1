{
  "name": "@mi/desktop",
  "productName": "Stratemark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/lYlarufAhmed/STRATEMARK-latest-",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:main": "node scripts/build.mjs --main-only",
    "build": "node scripts/build.mjs",
    "test": "vitest",
    "dev": "pnpm build && electron .",
    "dev:watch": "pnpm build:main && electron . --dev-server",
    "dist": "pnpm build && electron-builder --publish never",
    "test:run": "vitest run",
    "test:evidence-concurrency": "node scripts/check-evidence-concurrency.mjs"
  },
  "build": {
    "appId": "com.marketintel.deckbuilder",
    "productName": "Stratemark",
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "lYlarufAhmed",
      "repo": "STRATEMARK-latest-"
    },
    "files": [
      "dist/**",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web-dist"
      }
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Office"
    }
  },
  "dependencies": {
    "@mi/contracts": "workspace:*",
    "@mi/mocks": "workspace:*",
    "@mi/research": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "electron": "44.4.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
